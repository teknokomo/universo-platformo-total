{
  "name": "universo-platformo-total",
  "version": "0.1.0",
  "private": true,
  "description": "Universo Platformo implementation built on Total.js v5 and React+MUI",
  "scripts": {
    "build": "pnpm -r build",
    "build:all": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,json,md}\"",
    "clean": "pnpm -r clean && find packages -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "install:all": "pnpm install",
    "prepare": "husky install || true"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{js,json,md}": ["prettier --write"]
  }
}
