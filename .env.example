# Application
NODE_ENV=development
PORT=4000

# ── Supabase ────────────────────────────────────────────────
# Used by start-srv and auth-srv on the SERVER SIDE only.
# These credentials are NEVER sent to the browser.
# The frontend communicates with Supabase only via /api/auth/* routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT (optional — used by auth-srv if issuing custom JWTs) ─
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ── Database (optional — defaults to Supabase) ──────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/universo_platformo

# ── React packages (start-frt / auth-frt) ───────────────────
# These variables are only needed when running the React-based
# alternative packages (start-frt, auth-frt). They are NOT used
# by the Total.js Platform native package (start-srv).
#
# Note: VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are no longer used.
# Auth now goes through the backend /api/auth/* routes with httpOnly cookies.
# Kept commented for backwards reference only.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:4000

