{
  "name": "@universo-platformo/start-frt",
  "version": "0.1.0",
  "description": "Start pages for Universo Platformo (guest + authenticated)",
  "scripts": {
    "dev": "vite --config base/vite.config.ts",
    "build": "tsc && vite build --config base/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint base/src --ext .ts,.tsx",
    "preview": "vite preview --config base/vite.config.ts"
  },
  "dependencies": {
    "@universo-platformo/types": "workspace:*",
    "@universo-platformo/auth-frt": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "@mui/material": "^5.15.0",
    "@mui/icons-material": "^5.15.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
